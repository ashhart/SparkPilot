      "tests": [
        "retired_public_remote_mode_cannot_be_enabled",
        "retired_public_connector_operations_are_rejected"
      ]
    },
    "Certificate mismatch.": {
      "tests": [
        "aPinThatIsNotAFingerprintIsRefusedAtConstruction",
        "aSecondClaimAgainstADifferentCertificateIsRefused",
        "identity_keeps_tls_leaf_pin_distinct_from_pairing_authority"
      ]
    },
    "Unsigned/stale/revoked catalogue.": {
      "tests": [
        "tampered_catalogue_is_rejected_at_load",
