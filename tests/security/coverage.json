{
  "matrix": "PLAN \u00a749.3 Security tests",
  "note": "Each plan case maps to tests that must exist in the tree, or to a declared blocker with the command that would produce the missing evidence. tests/security/test_security_matrix.py enforces both directions.\n\nRelease-readiness fuzz (\u00a765 entry 81) is listed against the cases it strengthens rather than as a case of its own: the corpora in api_fuzz, signature_fuzz, inference_proxy_fuzz, protocol_fuzz, SSEParserFuzzTests and RequestSigningFuzzTests are what stop these cases being true only for the inputs someone thought of. Seeds, counts and invariants are recorded in docs/reviews/plan-closure-74.md entry 81; `just test-fuzz-security` runs them.",
  "cases": {
    "Expired/replayed pairing invitation.": {
      "tests": [
        "an_expired_challenge_is_unusable",
        "bootstrap_owner_issues_a_verifiable_single_use_invitation",
        "the_installer_grant_is_revoked_once_the_owner_claims"
      ]
    },
    "Challenge replay.": {
      "tests": [
        "an_expired_challenge_is_unusable",
        "a_presence_proof_is_single_use"
      ]
    },
    "Request nonce replay.": {
      "tests": [
        "one_nonce_admits_exactly_one_concurrent_request",
        "a_broken_replay_store_fails_closed",
        "replay_and_tampering_are_rejected"
      ]
    },
    "Timestamp skew.": {
      "tests": [
        "a_correctly_signed_request_outside_the_window_is_refused",
        "the_runtime_rebuilds_every_committed_vector"
      ]
    },
    "Body tampering.": {
      "tests": [
        "replay_and_tampering_are_rejected",
        "a_refused_body_is_a_client_error_that_changes_no_stored_state",
        "the_answer_does_not_depend_on_how_the_body_was_chunked",
        "a_refusal_never_echoes_the_body_back"
      ]
    },
    "Signature from wrong device.": {
      "tests": [
        "a_claim_may_not_substitute_a_different_device_key",
        "aSignatureFromAnotherKeyIsRefusedBeforeTransfer",
        "replay_and_tampering_are_rejected",
        "no_two_distinct_requests_share_canonical_bytes",
        "one_changed_field_changes_the_canonical_bytes_and_the_signature",
        "theAppRebuildsEveryGeneratedVector"
      ]
    },
    "Revoked grant.": {
      "tests": [
        "revocation_terminates_access",
        "administrator_cannot_escalate_or_revoke_owner_before_presence_prompt"
      ]
    },
    "Role escalation.": {
      "tests": [
        "an_observer_cannot_reach_any_privileged_surface",
        "administrator_cannot_escalate_or_revoke_owner_before_presence_prompt",
        "device_management_respects_the_authority_ceiling"
      ]
    },
    "Cloudflare token without Spark device signature.": {
      "retired": "Owner decision on 2026-09-05: public remote access was removed; Tailscale is the supported remote provider.",
      "tests": [
        "retired_public_remote_mode_cannot_be_enabled",
        "retired_public_connector_operations_are_rejected"
      ]
    },
    "Wrong Cloudflare audience/issuer.": {
