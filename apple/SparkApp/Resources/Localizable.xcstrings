    "provider.guided.unsupported": {
      "comment": "The prompt asked for structured output the proxy cannot request.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This prompt asks for guided generation against a schema, and the allowlisted chat proxy cannot carry one. The model would answer in free-form text that does not match the type you asked for."
          }
        }
      }
    },
    "provider.sampling.unsupported": {
      "comment": "The prompt asked for top-k, top-p or a seed the proxy cannot send.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Spark model is reached over the allowlisted chat proxy, which carries temperature and a token limit only. Constrained sampling cannot be expressed, and generating without it would not be what was asked for. Use greedy sampling or a temperature instead."
          }
        }
      }
    },
